# Kopiere diese Datei nach `.env.local` (gitignored) und trage echte Werte ein.
# In Produktion: Vercel → Project → Settings → Environment Variables.

# --- KI-Coach (Phase B) -----------------------------------------------------
# Server-seitig — wird nur in den app/api/atlas/*-Routen gelesen, nie im Browser.
# Ohne diesen Schlüssel zeigt der Coach „noch nicht eingerichtet"; die App läuft normal.
ANTHROPIC_API_KEY=

# Optional. Schützt die bezahlten ATLAS-Routen: ist der Wert gesetzt, nimmt der
# Server nur Anfragen mit diesem Code an. In der App einmal eintragen unter
# Einstellungen → Training → ATLAS. Ohne Wert bleibt alles offen.
ATLAS_ZUGANGSCODE=

# Optional. Ersetzen die Modelle aus lib/atlas/models.ts, z. B. zum Ausprobieren.
# Leer lassen für die Vorgabe (claude-fable-5-2 / claude-sonnet-5-5 / claude-opus-5-5).
ATLAS_MODEL=
ATLAS_FAST_MODEL=
ATLAS_FALLBACK_MODEL=

# --- Cloud-Sync (Phase C) ---------------------------------------------------
# Öffentlicher Anon-Key — Sicherheit kommt aus Row-Level-Security, nicht aus Geheimhaltung.
# Nach dem Setzen: das SQL aus supabase/SETUP.md einspielen (Tabelle + Bucket).
# Ohne diese Werte bleiben alle Daten lokal (kein Login, kein Sync).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
